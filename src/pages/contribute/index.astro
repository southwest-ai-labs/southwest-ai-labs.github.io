---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.svelte";
import Footer from "../../components/Footer.svelte";
import { SWAL_APPS } from "../../data/ecosystem";

const publicApps = SWAL_APPS.filter(app => app.repoStatus === "public" && app.repoUrl);
---

<Layout title="Contribute | SWAL">
  <Navbar client:load />
  <main class="pt-32 pb-24 px-6 max-w-4xl mx-auto space-y-12">
    <div class="space-y-4">
      <h1 class="text-4xl font-extrabold text-white font-mono">Contribute</h1>
      <p class="text-text-secondary leading-relaxed">How to contribute to the SouthWest AI Labs open source ecosystem.</p>
    </div>

    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-white font-mono">Contribution Guidelines</h2>
      <ol class="list-decimal pl-6 space-y-2 text-text-secondary">
        <li>Fork the repository of the app you want to contribute to.</li>
        <li>Create a feature branch.</li>
        <li>Commit using the <a href="https://www.conventionalcommits.org/" class="text-white underline">Conventional Commits</a> format.</li>
        <li>Submit a Pull Request.</li>
      </ol>
      <p class="text-text-secondary">Please review our <a href="https://github.com/iberi22/.github/blob/main/CODE_OF_CONDUCT.md" class="text-white underline">Code of Conduct</a>.</p>
    </section>

    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-white font-mono">Public Repositories</h2>
      <ul class="grid sm:grid-cols-2 gap-4">
        {publicApps.map(app => (
          <li class="p-4 border border-white/10 bg-bg-surface/50 rounded-xl">
            <a href={app.repoUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-white hover:underline">{app.name}</a>
            <p class="text-xs text-text-secondary mt-1">{app.tagline}</p>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer client:visible />
</Layout>
