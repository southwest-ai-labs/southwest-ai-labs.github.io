---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.svelte";
import Footer from "../../components/Footer.svelte";
import { SWAL_APPS, ISO_STANDARDS } from "../../data/ecosystem";
---

<Layout title="Roadmap | SWAL">
  <Navbar client:load />
  <main class="pt-32 pb-24 px-6 max-w-4xl mx-auto space-y-16">
    <div class="space-y-4">
      <h1 class="text-4xl font-extrabold text-white font-mono">Roadmap</h1>
      <p class="text-text-secondary leading-relaxed">Stage of each ecosystem app and our compliance roadmap.</p>
    </div>

    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-white font-mono">App Stages</h2>
      <ul class="space-y-4">
        {SWAL_APPS.map(app => (
          <li class="p-4 border border-white/10 bg-bg-surface/50 rounded-xl flex items-center justify-between">
            <span class="font-bold text-white">{app.name}</span>
            <span class="px-2 py-1 bg-white/5 border border-white/10 text-xs font-mono rounded uppercase">{app.status}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-white font-mono">Compliance Roadmap</h2>
      <ul class="space-y-4">
        {ISO_STANDARDS.map(std => (
          <li class="p-4 border border-white/10 bg-bg-surface/50 rounded-xl">
            <h3 class="font-bold text-white">{std.code} - {std.name}</h3>
            <p class="text-sm text-text-secondary mt-1">Aligned with / on our roadmap</p>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer client:visible />
</Layout>
